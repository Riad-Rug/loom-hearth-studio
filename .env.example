NEWSLETTER_API_KEY=

# Cron
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" when it calls /api/cron/* routes.
CRON_SECRET=

GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
